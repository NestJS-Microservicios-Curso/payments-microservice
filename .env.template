

PORT=3003

# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY

# URL of the frontend application to redirect after payment
STRIPE_SUCCESS_URL=http://localhost:3000/payments/success
STRIPE_CANCEL_URL=http://localhost:3000/payments/cancel

# Webhook signature secret for verifying Stripe webhook events
# Testing: If you are using Stripe CLI, you can get this value by running `stripe listen` and copying the value of the `Signing secret` from the output.
# STRIPE_WEBHOOK_SIGNATURE_SECRET=YOUR_STRIPE_WEBHOOK_SIGNATURE_SECRET

# Production: Hookdeck used to forward Stripe webhook events in production https://dashboard.hookdeck.com/connections
# You can find this value in your Stripe dashboard under Developers > Webhooks when you set up a webhook endpoint for your production environment.
# Example: https://dashboard.stripe.com/acct_1Qhy6WRx1C5CFKRj/test/workbench/webhooks
STRIPE_WEBHOOK_SIGNATURE_SECRET=YOUR_STRIPE_WEBHOOK_SIGNATURE_SECRET